# ── Telegram ───────────────────────────────────────────────────────────────
BOT_TOKEN=123456:ABC-your-token-from-@BotFather
OWNER_CHAT_ID=0                       # your own chat id; error reports go here

# ── Webhook (production).  Leave USE_POLLING=true for local dev ────────────
USE_POLLING=true
WEBHOOK_BASE=https://fpl.example.com  # public https base, no trailing slash
WEBHOOK_SECRET=change-me-to-32-random-chars
WEB_HOST=0.0.0.0
WEB_PORT=8080

# ── Storage ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://fpl:fpl@db:5432/fpl
REDIS_URL=redis://redis:6379/0

# ── Behaviour ──────────────────────────────────────────────────────────────
DEFAULT_TIMEZONE=Asia/Singapore
LIVE_POLL_SECONDS=45
FPL_MAX_CONCURRENCY=5
FPL_RATE_PER_SEC=4
LOG_LEVEL=INFO
